<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P06" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P06">
    <bpmn:participant id="Part_P06" name="P06 — Fiscalização técnica de campo (programada e por demanda) (AS-IS · 1 casos · estudo de caso)" processRef="Processo_P06" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P06" isExecutable="false">
    <bpmn:documentation>Das vistorias anuais programadas nas unidades da concessionária à ciência do parecer jurídico sobre a fiscalização Fontes: Processo SEI-480002/001314/2024 (caso designado; único processo do código na carteira, ainda em andamento): relatórios de fiscalização e ofícios da CASAN à concessionária ao longo do ciclo anual de vistorias, Parecer técnico CASAN, comunicação da Secretaria Executiva com o parecer, despacho da CASAN que reitera o parecer diante da manifestação da concessionária, despacho da Secretaria à Procuradoria, parecer da Procuradoria e ofício de ciência. A instauração do processo para vistorias anuais é a relatada no parecer da Procuradoria; a deliberação juntada no início é compilação do Diário Oficial e não sustenta etapa por si só. As respostas da concessionária aos ofícios e a manifestação da regulada são citadas nos pareceres e despachos, mas não estão juntadas entre as peças coletadas. Os processos de fiscalização relacionados não foram analisados.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P06">
      <bpmn:lane id="Lane_CASAN" name="Câmara Técnica de Saneamento (CASAN)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária (EXT)">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Processo de vistorias anuais instaurado">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="j1" name="">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g1" name="Vistoria a agendar com a concessionária?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t1" name="Solicitar agendamento de vistoria técnica&#10;[100% de 1 casos · espera 8,5 du · 1,8 h]">
      <bpmn:documentation>freq: 100% de 1; du: 8,5; horas: 1,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="j2" name="">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2" name="Vistoriar unidade e emitir relatório de fiscalização&#10;[100% de 1 casos · espera 10,5 du · 31,5 h]">
      <bpmn:documentation>freq: 100% de 1; du: 10,5; horas: 31,5 h; status: perda; nota: Perda: pedido complementacao (100%), prazo concedido (100%)</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Outras unidades no mesmo lote?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Encaminhar relatórios e solicitar manifestação&#10;[100% de 1 casos · espera 6 du · 0,8 h]">
      <bpmn:documentation>freq: 100% de 1; du: 6; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3" name="Vistorias do ciclo anual concluídas?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="e1" name="Respostas e planos de ação da concessionária recebidos">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t4" name="Analisar respostas e emitir parecer técnico&#10;[100% de 1 casos · espera 106 du · 24,2 h]">
      <bpmn:documentation>freq: 100% de 1; du: 106; horas: 24,2 h; status: espera; nota: Espera mediana 106 du (q3 106); Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Dar ciência do parecer técnico à concessionária&#10;[100% de 1 casos · espera 55 du · 0,4 h]">
      <bpmn:documentation>freq: 100% de 1; du: 55; horas: 0,4 h; status: espera; nota: Espera mediana 55 du (q3 55)</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Manifestação da concessionária recebida">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t6" name="Reanalisar manifestação e reiterar parecer técnico&#10;[100% de 1 casos · espera 26 du · 4 h]">
      <bpmn:documentation>freq: 100% de 1; du: 26; horas: 4 h; status: espera; nota: Espera mediana 26 du (q3 26); Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Analisar fundamentos jurídicos da fiscalização&#10;[100% de 1 casos · espera 205 du · 6 h]">
      <bpmn:documentation>freq: 100% de 1; du: 205; horas: 6 h; status: espera; nota: Espera mediana 205 du (q3 205); Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Dar ciência do parecer jurídico à concessionária&#10;[100% de 1 casos · espera 0 du · 0,8 h]">
      <bpmn:documentation>freq: 100% de 1; du: 0; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Concessionária cientificada para regularizar pendências">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
